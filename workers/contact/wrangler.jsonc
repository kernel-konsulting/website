{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kk-contact",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",

  // Must be false. With it true (or absent) wrangler tries to publish to
  // <account>.workers.dev, and an account that has never registered a
  // workers.dev subdomain fails the deploy outright — without ever reaching
  // the custom domain route below.
  "workers_dev": false,

  // Custom domain. Wrangler creates the DNS record and certificate on deploy.
  // Comment this out to deploy to the *.workers.dev URL only while testing.
  "routes": [{ "pattern": "api.kernelkonsulting.com", "custom_domain": true }],

  "vars": {
    // Comma-separated. Anything not on this list is rejected before the body
    // is even parsed.
    "ALLOWED_ORIGINS": "https://kernelkonsulting.com,https://www.kernelkonsulting.com,https://kernel-konsulting.github.io",
    "SITE_NAME": "kernelkonsulting.com",
    "MAIL_TO": "contact@kernelkonsulting.com",
    // Must be on a domain the delivery provider has verified. Delivery goes
    // through Resend, so this is the subdomain verified there. It is a
    // subdomain on purpose: everything Resend needs is TXT records on `send.`,
    // which leaves the apex MX/SPF/DMARC that Proton depends on untouched.
    "MAIL_FROM": "website@send.kernelkonsulting.com",
    "TURNSTILE_HOSTNAMES": "kernelkonsulting.com,www.kernelkonsulting.com,kernel-konsulting.github.io",
    "TURNSTILE_ACTION": "contact"

    // TURNSTILE_SECRET_KEY is deliberately NOT here.
    //
    // A `vars` entry and a `wrangler secret` cannot coexist: on every deploy
    // the var overwrites the stored secret, silently disabling the CAPTCHA.
    // Set it once, and only once, with:
    //
    //   npx wrangler secret put TURNSTILE_SECRET_KEY
    //
    // The Worker logs a warning on every request while it is running on
    // Cloudflare's always-pass test key.
  },

  // Cloudflare Email Sending. KEYS are declared but unused: on the Workers
  // free plan this product cannot onboard a sending domain, so it can only
  // send to verified destination addresses *from a routing domain* — and
  // enabling Email Routing would mean handing Cloudflare the apex MX that
  // Proton currently owns. Delivery therefore goes through Resend instead, via
  // the RESEND_API_KEY secret. `deliver()` in src/index.js prefers Resend when
  // that secret is present and falls back to this binding otherwise, so the
  // binding stays here and costs nothing.
  "send_email": [{ "name": "EMAIL", "remote": true }],

  // Per-IP burst limit. The platform only supports 10s or 60s windows, so this
  // is a burst guard; Turnstile is what carries the real weight.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],

  "observability": { "enabled": true }
}
