{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kk-contact",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,

  // Custom domain. Wrangler creates the DNS record and certificate on deploy.
  // Comment this out to deploy to the *.workers.dev URL only while testing.
  "routes": [{ "pattern": "api.kernelkonsulting.com", "custom_domain": true }],

  "vars": {
    // Comma-separated. Anything not on this list is rejected before the body
    // is even parsed.
    "ALLOWED_ORIGINS": "https://kernelkonsulting.com,https://www.kernelkonsulting.com,https://kernel-konsulting.github.io",
    "SITE_NAME": "kernelkonsulting.com",
    "MAIL_TO": "contact@kernelkonsulting.com",
    // Must be an address on a domain onboarded for Cloudflare Email Sending.
    // This assumes you onboarded the subdomain `send.kernelkonsulting.com`,
    // which leaves the apex MX/SPF/DMARC that Proton depends on untouched.
    // Onboarding the apex instead works too — change this to
    // website@kernelkonsulting.com in that case.
    "MAIL_FROM": "website@send.kernelkonsulting.com",
    "TURNSTILE_HOSTNAMES": "kernelkonsulting.com,www.kernelkonsulting.com,kernel-konsulting.github.io",
    "TURNSTILE_ACTION": "contact",

    // ------------------------------------------------------------------
    // Cloudflare's published ALWAYS-PASS test secret. It makes the Worker
    // runnable before you have a real widget, and it must be replaced
    // before the site goes live:
    //
    //   npx wrangler secret put TURNSTILE_SECRET_KEY
    //
    // That write removes this var and stores the real value encrypted.
    // ------------------------------------------------------------------
    "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA"
  },

  // Cloudflare Email Sending. Sends are free to verified destination
  // addresses on any plan, which is the only thing this Worker does.
  "send_email": [{ "name": "EMAIL", "remote": true }],

  // Per-IP burst limit. The platform only supports 10s or 60s windows, so this
  // is a burst guard; Turnstile is what carries the real weight.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],

  "observability": { "enabled": true }
}
